# Site URL used for canonical links, hreflang, sitemap and Open Graph.
# Set this when building for a domain other than production (a hoster subdomain,
# a staging URL) — otherwise those tags will point at sakclinic.kz.
NEXT_PUBLIC_SITE_URL=https://sakclinic.kz

# Analytics. Both are embedded into the bundle at build time: if they are empty
# during the build, the counters silently do not load.
NEXT_PUBLIC_YANDEX_METRICA_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
