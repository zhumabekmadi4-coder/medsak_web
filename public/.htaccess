# Apache config for the static export of sakclinic.kz.
# Copied into out/ automatically during `next build`.

Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# www -> apex. Every canonical tag points at the www-less host, so serving both
# means two live copies of the same page.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Site root -> Russian locale. public/index.html stays as a fallback for hosts
# that do not allow rewrites.
RewriteRule ^$ /ru/ [R=302,L]

# trailingSlash: true — add the slash so DirectoryIndex finds index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

<IfModule mod_headers.c>
    # Enable only once HTTPS is confirmed working on the new host.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    # Browser default on purpose: Meta's Event Setup Tool opens the site from
    # business.facebook.com and drives it over postMessage; any stricter COOP
    # severs window.opener and the tool reports "pixel not detected".
    Header always set Cross-Origin-Opener-Policy "unsafe-none"
    Header always set X-Permitted-Cross-Domain-Policies "none"

    # Meta hosts: connect.facebook.net is the pixel itself; www.facebook.com,
    # static.xx.fbcdn.net and business.facebook.com are the Event Setup Tool
    # overlay (signals/iwl.js), which Events Manager injects into the live site.
    # 'unsafe-inline' is unavoidable: Next and both analytics counters inject
    # inline scripts, and a static host cannot issue a nonce.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://mc.yandex.com https://yastatic.net https://www.googletagmanager.com https://connect.facebook.net https://www.facebook.com https://static.xx.fbcdn.net; style-src 'self' 'unsafe-inline' https://www.facebook.com https://static.xx.fbcdn.net; img-src 'self' data: https://mc.yandex.ru https://mc.yandex.com https://www.google-analytics.com https://www.facebook.com https://static.xx.fbcdn.net; font-src 'self' data: https://static.xx.fbcdn.net; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com https://www.google-analytics.com https://region1.google-analytics.com https://www.facebook.com https://connect.facebook.net https://business.facebook.com https://graph.facebook.com; frame-src https://www.facebook.com https://business.facebook.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

    # Hashed build assets never change under the same name.
    <FilesMatch "\.(js|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(webp|avif|jpe?g|png|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    # HTML must not be cached, otherwise a release never reaches visitors.
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain
</IfModule>

# Do not serve source or config leftovers
<FilesMatch "^\.(env|git)">
    Require all denied
</FilesMatch>
